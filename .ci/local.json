{
  "version": 1,
  "description": "Sub0Physics local checks (docs/ci-strategy.md); run: python <.github repo>/tools/ci/local_ci.py --level quick|full",
  "selftest": [
    "{python} ../Sub0Math/tools/perf/bench_check.py selftest --repo ."
  ],
  "levels": {
    "quick": {
      "steps": [
        {
          "name": "gcc",
          "compiler": "gcc",
          "commands": [
            "cmake --preset default -B {builddir} -G Ninja -DSUB0PHYSICS_WARNINGS_AS_ERRORS=ON -DSUB0PHYSICS_BUILD_BENCHMARKS=OFF -DSUB0MATH_PERF_ON_BUILD=OFF -DSUB0MATH_PERF_GIT_HOOKS=OFF",
            "cmake --build {builddir} -j {jobs}",
            "ctest --preset quick --test-dir {builddir}"
          ]
        },
        {
          "name": "clang-x86-64-v3",
          "compiler": "clang",
          "optional": true,
          "commands": [
            "cmake --preset default -B {builddir} -G Ninja -DSUB0PHYSICS_WARNINGS_AS_ERRORS=ON -DSUB0PHYSICS_BUILD_BENCHMARKS=OFF -DSUB0MATH_PERF_ON_BUILD=OFF -DSUB0MATH_PERF_GIT_HOOKS=OFF -DCMAKE_CXX_FLAGS=-march=x86-64-v3",
            "cmake --build {builddir} -j {jobs}",
            "ctest --preset quick --test-dir {builddir}"
          ]
        },
        {
          "name": "private-names",
          "commands": [
            "{python} {ci_dir}/private_names.py --staged --repo {repo}",
            "{python} {ci_dir}/private_names.py --tree --repo {repo}"
          ]
        },
        {
          "name": "hook-check",
          "commands": [
            "{python} {ci_dir}/hook_check.py --repo {repo}"
          ]
        }
      ]
    },
    "full": {
      "steps": [
        {
          "name": "gcc",
          "compiler": "gcc",
          "commands": [
            "cmake --preset default -B {builddir} -G Ninja -DSUB0PHYSICS_WARNINGS_AS_ERRORS=ON -DSUB0PHYSICS_BUILD_BENCHMARKS=OFF -DSUB0MATH_PERF_ON_BUILD=OFF -DSUB0MATH_PERF_GIT_HOOKS=OFF",
            "cmake --build {builddir} -j {jobs}",
            "ctest --preset full --test-dir {builddir}"
          ]
        },
        {
          "name": "clang-x86-64-v3",
          "compiler": "clang",
          "optional": true,
          "commands": [
            "cmake --preset default -B {builddir} -G Ninja -DSUB0PHYSICS_WARNINGS_AS_ERRORS=ON -DSUB0PHYSICS_BUILD_BENCHMARKS=OFF -DSUB0MATH_PERF_ON_BUILD=OFF -DSUB0MATH_PERF_GIT_HOOKS=OFF -DCMAKE_CXX_FLAGS=-march=x86-64-v3",
            "cmake --build {builddir} -j {jobs}",
            "ctest --preset full --test-dir {builddir}"
          ]
        },
        {
          "name": "wasm",
          "commands": [
            "{python} ../Sub0Math/tools/wasm/wasm_gate.py --repo {repo} --prefix SUB0PHYSICS"
          ]
        }
      ]
    }
  }
}
